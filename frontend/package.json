{
  "name": "@reward-lens/frontend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "The reward-lens component tree for the offline report and local workbench.",
  "workspaces": [
    "report",
    "workbench"
  ],
  "scripts": {
    "build:report": "vite build --config vite.config.ts && node report/build/extract.mjs",
    "build:workbench": "vite build --config vite.config.ts --mode workbench",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "hyparquet": "1.30.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
